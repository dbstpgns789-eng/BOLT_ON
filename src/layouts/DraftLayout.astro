---
import '../styles/site/page.css';
import CallBar from '../components/CallBar.astro';
import { company } from '../config/company';
import { hero } from '../data/services';

interface Props { variant: string; reveal?: boolean; noto?: boolean }
const { variant, reveal = false, noto = false } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{company.nameKo} | 전기 증설·고압 수변전설비 전기공사</title>
  <meta name="description" content={hero.sentence} />
  <meta name="robots" content="noindex" />
  <script is:inline>document.documentElement.classList.add("js");</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={`https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@87.5,500;87.5,700;100,800${noto ? '&family=Noto+Sans+KR:wght@400;600;800' : ''}&display=swap`} rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body class={`v-${variant}${noto ? ' f-noto' : ''}${reveal ? ' has-reveal' : ''}`}>
  <slot />
  <CallBar />
  {reveal && (
    <script>
      // Sections fade up once as they enter; without the script (or with reduced motion) everything is simply visible.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => { el.classList.add('will-reveal'); io.observe(el); });
      }
    </script>
  )}
</body>
</html>
