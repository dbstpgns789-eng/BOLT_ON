---
// Every page's shell: head (title, description, fonts, icon), skip link, mobile call bar, and on the home page the
// one-time section reveal. Search engines are kept out until company.launched is set to true on launch day.
import '../styles/site/page.css';
import CallBar from '../components/CallBar.astro';
import { company } from '../config/company';
import { siteDescription } from '../data/services';

interface Props { title?: string; description?: string; reveal?: boolean }
const { title, description, reveal = false } = Astro.props;
const fullTitle = title ? `${title} | ${company.nameKo}` : `${company.nameKo} | 전기 증설·고압 수변전설비 전기공사`;
const desc = description ?? siteDescription;
const url = new URL(Astro.url.pathname, Astro.site);
// Share preview (KakaoTalk, Naver, Facebook): one site-wide image, the hero substation photo cropped to 1200×630.
const ogImage = new URL('/og-image.jpg', Astro.site);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={company.nameKo} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {!company.launched && <meta name="robots" content="noindex" />}
  <script is:inline>document.documentElement.classList.add("js");</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@87.5,500;87.5,700;100,800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body class={reveal ? 'has-reveal' : undefined}>
  <a class="skip" href="#top">본문 바로가기</a>
  <slot />
  <CallBar />
  {reveal && (
    <script>
      // Sections fade up once as they enter; without the script (or with reduced motion) everything is simply visible.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => { el.classList.add('will-reveal'); io.observe(el); });
      }
    </script>
  )}
</body>
</html>
