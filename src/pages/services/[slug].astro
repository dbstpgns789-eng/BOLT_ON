---
// Business-area pages, fixed from draft S4 (2026-11-11): intro with photo · sub-tasks · steps with owners
// · this area's cases (hidden when none) · callback request form · other areas. No FAQ (client decision).
import DraftLayout from '../../layouts/DraftLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import ServiceBanner from '../../components/service/ServiceBanner.astro';
import ServiceIntro from '../../components/service/ServiceIntro.astro';
import ServiceTasks from '../../components/service/ServiceTasks.astro';
import ServiceProcess from '../../components/service/ServiceProcess.astro';
import ServiceCases from '../../components/service/ServiceCases.astro';
import ConsultForm from '../../components/service/ConsultForm.astro';
import OtherAreas from '../../components/service/OtherAreas.astro';
import { services, type ServiceSlug } from '../../data/services';
import { servicePages } from '../../data/service-pages';
import { serviceMedia } from '../../data/service-media';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const slug = Astro.params.slug as ServiceSlug;
const service = services.find((s) => s.slug === slug)!;
const page = servicePages[slug];
const media = serviceMedia[slug];
// "전기 증설·승압이란?" / "고압 수변전설비란?": 이란 after a final consonant (받침), 란 otherwise.
const topic = service.name.replace(/ (공사|전기공사)$/, '');
const last = topic.charCodeAt(topic.length - 1) - 0xac00;
const heading = `${topic}${last >= 0 && last % 28 !== 0 ? '이란' : '란'}?`;
---
<DraftLayout variant="svc" title={service.name} description={page.lead}>
  <SiteHeader />
  <main id="top">
    <ServiceBanner slug={slug} photo={media.banner} />
    <ServiceIntro page={page} heading={heading} photo={media.intro} photoAlt={media.introAlt} />
    <ServiceTasks page={page} />
    <ServiceProcess page={page} variant="lanes" />
    <ServiceCases slug={slug} variant="cards" />
    <ConsultForm slug={slug} />
    <OtherAreas slug={slug} />
  </main>
  <SiteFooter />
</DraftLayout>
