---
// Home. Fixed from draft D4 (client pick, 2026-11-10) with the F3 layout / F1 colour footer.
import DraftLayout from '../layouts/DraftLayout.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import HeroCarousel from '../components/home/HeroCarousel.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import Steps from '../components/home/Steps.astro';
import CaseStrip from '../components/home/CaseStrip.astro';
import Kepco from '../components/home/Kepco.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { slides } from '../data/slides';
---
<DraftLayout variant="d4" reveal>
  <SiteHeader />
  <main id="top">
    <HeroCarousel slides={slides} />
    <CaseStrip />
    <ServiceCards />
    <Steps />
    <Kepco />
  </main>
  <SiteFooter />
</DraftLayout>
