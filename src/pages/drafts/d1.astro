import DraftLayout from '../../layouts/DraftLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import HeroCarousel from '../../components/home/HeroCarousel.astro';
import ServiceCards from '../../components/home/ServiceCards.astro';
import Steps from '../../components/home/Steps.astro';
import CaseFeature from '../../components/home/CaseFeature.astro';
