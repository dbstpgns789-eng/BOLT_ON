---
// Drafts (2026-11-11): route buttons with the official Kakao Map icon, two ways to keep the brand colours.
import DraftLayout from '../../layouts/DraftLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import RouteButtons from '../../components/company/RouteButtons.astro';
import { company } from '../../config/company';
const variants = [
  ['split', 'A. 나눈 버튼', '왼쪽 흰 칸에 아이콘, 오른쪽 칸은 브랜드 색. 카카오 아이콘이 노란 바탕에 직접 닿지 않습니다.'],
  ['plain', 'B. 흰 버튼', '흰 버튼에 아이콘과 글자. 브랜드 색은 아이콘에만 들어갑니다.'],
] as const;
---
<DraftLayout variant="svc" title="길찾기 버튼 시안">
  <SiteHeader />
  <main id="top">
    {variants.map(([v, t, line]) => (
      <section class="section">
        <div class="container">
          <div class="head"><h2>{t}</h2><p>{line}</p></div>
          <RouteButtons address={company.address} variant={v} />
        </div>
      </section>
    ))}
  </main>
</DraftLayout>
