---
// 시안 D · 시안 C(우일 흐름) + 클라이언트 의견(research/industry/RE-REPORT.md §4):
// 드롭다운 메뉴, 메뉴 아래 사진 슬라이드, 사업분야 사진 카드 → 상세.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import '../../styles/d/page.css';
import Logo from '../../components/Logo.astro';
import CallBar from '../../components/CallBar.astro';
import { company, telHref } from '../../config/company';
import { services, steps, hero } from '../../data/services';
import { ym, stageKo } from '../../lib/format';
import substation from '../../assets/stock/substation-transformer.jpg';
import insulators from '../../assets/stock/transformer-insulators.jpg';
import panel from '../../assets/stock/distribution-panel.jpg';
import studs from '../../assets/stock/remodeling-studs.jpg';
import seodaemun from '../../assets/cases/seodaemun-prison/04-exhibit-screens.jpg';
import gimhaeFacade from '../../assets/cases/gimhae-museum/01-facade.jpg';

const all = await getCollection('cases');
const featured = all.sort((a, b) => (a.data.featured ?? 99) - (b.data.featured ?? 99)).slice(0, 2);
const serviceName = Object.fromEntries(services.map((s) => [s.slug, s.name]));

const slides = [
  { img: substation, alt: '변전소의 대형 변압기와 수전 설비', head: hero.headline, line: hero.sentence, pos: '60% 50%' },
  { img: seodaemun, alt: '서대문형무소역사관 전시실의 영상 모니터와 조명', head: '전시 조명부터 영상 설비 전원까지', line: '서대문형무소역사관 유관순 열사 옥사, 2026년 8월 시공.', pos: '50% 50%' },
  { img: panel, alt: '차단기와 배선이 정리된 분전반', head: '한전 신청 서류도 함께 준비합니다', line: '증설, 승압, 임시전력 신청을 공사와 한 번에 진행합니다.', pos: '50% 55%' },
];
const cardImg = { substation, capacity: panel, transformer: insulators, wiring: studs, newbuild: gimhaeFacade } as const;

const menu = [
  { label: '회사소개', href: '#company', sub: [['회사 개요', '#company'], ['오시는 길', '#company']] },
  { label: '사업분야', href: '#services', sub: services.map((s) => [s.name, '#services'] as [string, string]) },
  { label: '시공사례', href: '#cases', sub: [['전체 시공사례', '#cases'], ['고압 수변전설비', '#cases'], ['증설·승압', '#cases'], ['내선·리모델링', '#cases']] },
  { label: '한전 신청 안내', href: '#kepco', sub: [['신청 절차', '#kepco'], ['준비 서류', '#kepco'], ['자주 묻는 질문', '#kepco']] },
];
const info = [
  ['상호', `${company.nameKo} (${company.nameEn})`],
  ['법인명', company.legalName],
  ['대표', company.ceo],
  ['사업자등록번호', company.bizNumber],
  ['전기공사업 등록번호', company.licenseNumber],
  ['주소', company.address],
  ['전화', company.phone],
  ['이메일', company.email],
  ['상담 시간', company.hours],
].filter(([, v]) => v);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{company.nameKo} | 전기 증설·고압 수변전설비 전기공사</title>
  <meta name="description" content={hero.sentence} />
  <meta name="robots" content="noindex" />
  <script is:inline>document.documentElement.classList.add("js");</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@87.5,500;87.5,700;100,500;100,800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body>
  <header class="nav">
    <div class="container nav-row">
      <a class="brand" href="#top" aria-label={`${company.nameKo} 처음으로`}><Logo variant="horizontal" class="brand-logo" /></a>
      <nav class="gnb" aria-label="주요 메뉴">
        <ul class="gnb-list">
          {menu.map((m) => (
            <li class="gnb-item">
              <a class="gnb-link" href={m.href}>{m.label}</a>
              <ul class="gnb-sub">
                {m.sub.map(([t, h]) => <li><a href={h}>{t}</a></li>)}
              </ul>
            </li>
          ))}
        </ul>
        <div class="gnb-panel" aria-hidden="true"></div>
      </nav>
      <a class="nav-call" href={telHref}><span class="nav-call-label">전화 상담</span> {company.phone}</a>
      <details class="mnav">
        <summary aria-label="메뉴 열기">메뉴</summary>
        <div class="mnav-body">
          {menu.map((m) => (
            <div class="mnav-group">
              <a class="mnav-head" href={m.href}>{m.label}</a>
              {m.sub.map(([t, h]) => <a href={h}>{t}</a>)}
            </div>
          ))}
        </div>
      </details>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-roledescription="carousel" aria-label="볼트온이엔씨 소개">
      <div class="slides">
        {slides.map((s, i) => (
          <div class={`slide${i === 0 ? ' is-active' : ''}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
            <Image src={s.img} alt={s.alt} widths={[800, 1280, 1920, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position: ${s.pos}`} />
            <div class="container slide-text">
              {i === 0 ? <h1>{s.head}</h1> : <p class="slide-head">{s.head}</p>}
              <p class="lead">{s.line}</p>
              {i === 0 && (
                <div class="actions">
                  <a class="btn btn--primary" href={telHref}>전화 상담</a>
                  <a class="btn btn--ghost" href="#cases">시공사례 보기</a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="container slide-controls">
        <button class="slide-btn" type="button" data-dir="-1" aria-label="이전 슬라이드">이전</button>
        <span class="slide-count" aria-live="polite"><span data-current>1</span> / {slides.length}</span>
        <button class="slide-btn" type="button" data-dir="1" aria-label="다음 슬라이드">다음</button>
      </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="head">
          <h2 id="services-title">사업분야</h2>
          <p>분야를 누르면 공사 내용과 진행 과정을 자세히 볼 수 있습니다.</p>
        </div>
        <ul class="cards">
          {services.map((s) => (
            <li class="card">
              <a class="card-link" href="#services">
                <span class="card-text">
                  <span class="card-title">{s.name}</span>
                  <span class="card-line">{s.tasks.slice(0, 2).join(', ')}</span>
                  <span class="card-go">자세히 보기</span>
                </span>
                <Image class="card-img" src={cardImg[s.slug]} alt="" widths={[400, 640]} sizes="(max-width: 60rem) 60vw, 280px" />
              </a>
            </li>
          ))}
          <li class="card card--navy">
            <a class="card-link" href="#kepco">
              <span class="card-text">
                <span class="card-title">한전 신청 대행</span>
                <span class="card-line">증설·승압·임시전력 신청 서류</span>
                <span class="card-go">자세히 보기</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--tint" aria-labelledby="steps-title">
      <div class="container">
        <div class="head">
          <h2 id="steps-title">진행 순서</h2>
          <p>한전 신청 서류는 공사와 함께 저희가 준비합니다.</p>
        </div>
        <ol class="chevrons">
          {steps.map((s, i) => (
            <li>
              <span class="c-num">{i + 1}</span>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="cases" aria-labelledby="cases-title">
      <div class="container">
        <div class="head head--row">
          <div>
            <h2 id="cases-title">시공사례</h2>
            <p>직접 시공한 현장을 공사 전후 사진과 함께 기록합니다.</p>
          </div>
          <a class="more" href="#cases">전체 보기</a>
        </div>
        <div class="cases">
          {featured.map((c) => {
            const shots = [...c.data.photos.filter((p) => p.stage !== 'during'), ...c.data.photos.filter((p) => p.stage === 'during')].slice(0, 2);
            return (
              <article class="case">
                <div class="case-shots">
                  {shots.map((p) => (
                    <figure>
                      <Image src={p.src} alt={p.caption} widths={[360, 560]} sizes="(max-width: 60rem) 50vw, 300px" />
                      <figcaption>{stageKo[p.stage]}</figcaption>
                    </figure>
                  ))}
                </div>
                <div class="case-body">
                  <p class="case-area">{serviceName[c.data.service]}</p>
                  <h3>{c.data.title}</h3>
                  <p class="case-meta">{c.data.region}, {ym(c.data.completed)} 완공{c.data.duration && `, 공사 기간 ${c.data.duration}`}</p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="kepco" id="kepco" aria-labelledby="kepco-title">
      <div class="container kepco-row">
        <div>
          <h2 id="kepco-title">한전 신청 절차와 필요 서류</h2>
          <p>증설, 승압, 임시전력, 모자분리. 신청 종류별로 무엇을 준비하면 되는지 정리했습니다.</p>
        </div>
        <a class="btn btn--primary" href="#kepco">한전 신청 안내 보기</a>
      </div>
    </section>

    <section class="section" id="company" aria-labelledby="company-title">
      <div class="container company">
        <div class="head">
          <h2 id="company-title">회사 정보</h2>
          <p>현장 상황을 듣고 방문 일정을 바로 잡아 드립니다.</p>
          <a class="btn btn--primary" href={telHref}>{company.phone}</a>
        </div>
        <table class="info">
          <tbody>{info.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-row">
      <div>
        <Logo variant="horizontal" onDark class="footer-logo" />
        <p class="footer-small">© 2026 {company.nameEn}</p>
      </div>
      <p>{company.nameKo}, 대표 {company.ceo}<br />{company.address}<br />전화 {company.phone}, 이메일 {company.email}{company.bizNumber && <><br />사업자등록번호 {company.bizNumber}</>}{company.licenseNumber && <><br />전기공사업 {company.licenseNumber}</>}</p>
      <nav class="footer-links" aria-label="바닥글 메뉴">
        {menu.map((m) => <a href={m.href}>{m.label}</a>)}
      </nav>
    </div>
  </footer>
  <CallBar />

  <script>
    const root = document.querySelector('.hero');
    const slides = [...document.querySelectorAll('.slide')];
    const current = document.querySelector('[data-current]');
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('is-active', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
      if (current) current.textContent = String(i + 1);
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce) { stop(); timer = window.setInterval(() => show(i + 1), 6000); } };
    const stop = () => { if (timer) window.clearInterval(timer); };
    document.querySelectorAll<HTMLButtonElement>('.slide-btn').forEach((b) => b.addEventListener('click', () => { show(i + Number(b.dataset.dir)); start(); }));
    root?.addEventListener('mouseenter', stop);
    root?.addEventListener('mouseleave', start);
    root?.addEventListener('focusin', stop);
    root?.addEventListener('focusout', start);
    start();
  </script>
</body>
</html>
