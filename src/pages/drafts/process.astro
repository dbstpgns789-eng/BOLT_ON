---
// Drafts (2026-11-11): three ways to draw a long process. Same data in each: 고압 수변전설비 (6 steps) and 한전 신청 (8 steps).
import DraftLayout from '../../layouts/DraftLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import ProcessFlow from '../../components/ProcessFlow.astro';
import { servicePages } from '../../data/service-pages';
import { steps as kepcoSteps } from '../../data/kepco';

const svc = servicePages.substation.process;
const variants = [
  ['boxes', 'A. 상자 흐름도', '번호 상자를 화살표로 잇습니다. 한 줄에 3칸(6단계) 또는 4칸(8단계).'],
  ['timeline', 'B. 타임라인', '동그라미를 선 하나로 잇고, 동그라미 색으로 담당을 나눕니다.'],
  ['lanes', 'C. 담당자별 줄', '담당자마다 줄을 나누고, 단계를 그 줄에 놓습니다. 왼쪽에서 오른쪽으로 진행합니다.'],
] as const;
---
<DraftLayout variant="svc">
  <SiteHeader />
  <main id="top">
    {variants.map(([v, title, line], k) => (
      <section class={`section${k % 2 ? ' section--tint' : ''}`} aria-labelledby={`pv-${v}`}>
        <div class="container">
          <div class="head">
            <h2 id={`pv-${v}`}>{title}</h2>
            <p>{line}</p>
          </div>
          <h3 class="pv-sub">고압 수변전설비 공사 (6단계)</h3>
          <ProcessFlow steps={svc} variant={v} />
          <h3 class="pv-sub">한전 신청 안내 (8단계)</h3>
          <ProcessFlow steps={kepcoSteps} variant={v} />
        </div>
      </section>
    ))}
  </main>
</DraftLayout>
