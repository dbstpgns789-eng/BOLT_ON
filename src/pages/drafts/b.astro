---
// 시안 B · Formwork(현장형). Hallmark theme Formwork, brand-tinted (navy ink, amber safety signal).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import '../../styles/b/page.css';
import Logo from '../../components/Logo.astro';
import CallBar from '../../components/CallBar.astro';
import { company, telHref } from '../../config/company';
import { services, steps, hero } from '../../data/services';
import { ym } from '../../lib/format';

const cases = (await getCollection('cases')).sort((a, b) => b.data.completed.localeCompare(a.data.completed));
const featured = (await getCollection('cases')).sort((a, b) => (a.data.featured ?? 99) - (b.data.featured ?? 99)).slice(0, 2);
const serviceName = Object.fromEntries(services.map((s) => [s.slug, s.name]));
const info = [
  ['상호', `${company.nameKo} (${company.nameEn})`],
  ['법인명', company.legalName],
  ['대표', company.ceo],
  ['사업자등록번호', company.bizNumber],
  ['전기공사업 등록번호', company.licenseNumber],
  ['주소', company.address],
  ['상담 시간', company.hours],
].filter(([, v]) => v);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{company.nameKo} | 전기 증설·고압 수변전설비 전기공사</title>
  <meta name="description" content={hero.sentence} />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Archivo:wght@400;500;800&family=Archivo+Narrow:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body class="cast">
  <header class="banner">
    <div class="container banner-row">
      <a class="brand" href="#top" aria-label={`${company.nameKo} 처음으로`}><Logo variant="horizontal" class="brand-logo" /></a>
      <nav class="links" aria-label="주요 메뉴">
        <a href="#services">사업분야</a>
        <a href="#cases">시공사례</a>
        <a href="#kepco">한전 신청 안내</a>
        <a href="#company">회사소개</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-text">
          <h1 id="hero-title">{hero.headline}</h1>
          <p class="lead">{hero.sentence}</p>
          <div class="actions">
            <a class="btn btn--primary" href={telHref}>전화 상담 {company.phone}</a>
            <a class="btn btn--secondary" href="#cases">시공사례</a>
          </div>
        </div>
        <div class="board plate" aria-labelledby="board-title">
          <h2 id="board-title" class="board-title">최근 끝낸 현장</h2>
          <table>
            <thead><tr><th scope="col">완공</th><th scope="col">현장</th><th scope="col">공사</th></tr></thead>
            <tbody>
              {cases.map((c) => (
                <tr>
                  <td class="figure">{ym(c.data.completed)}</td>
                  <td><span class="site">{c.data.site}</span><span class="region">{c.data.region}</span></td>
                  <td>{serviceName[c.data.service]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-title">
      <div class="container">
        <h2 id="services-title">맡는 공사 다섯 가지</h2>
        <ol class="services">
          {services.map((s, i) => (
            <li>
              <span class="figure s-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
              <p class="tasks">{s.tasks.join(', ')}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section band--cast" aria-labelledby="steps-title">
      <div class="container">
        <h2 id="steps-title">일하는 순서</h2>
        <ol class="pour">
          {steps.map((s, i) => (
            <li>
              <span class="pour-num">{i + 1}</span>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="cases" aria-labelledby="cases-title">
      <div class="container">
        <h2 id="cases-title">시공사례</h2>
        <div class="cases">
          {featured.map((c) => {
            const cover = c.data.photos.find((p) => p.stage === 'after') ?? c.data.photos[0];
            return (
              <article class="case">
                <figure class="photo">
                  <Image src={cover.src} alt={cover.caption} widths={[480, 720, 960]} sizes="(max-width: 60rem) 100vw, 620px" />
                  <figcaption>{cover.caption}</figcaption>
                </figure>
                <h3>{c.data.title}</h3>
                <table class="facts">
                  <tbody>
                    <tr><th scope="row">지역</th><td>{c.data.region}</td></tr>
                    <tr><th scope="row">완공</th><td>{ym(c.data.completed)}</td></tr>
                    {c.data.duration && <tr><th scope="row">공사 기간</th><td>{c.data.duration}</td></tr>}
                    <tr><th scope="row">작업</th><td>{c.data.tags.join(', ')}</td></tr>
                  </tbody>
                </table>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="ink" id="kepco" aria-labelledby="kepco-title">
      <div class="container ink-row">
        <h2 id="kepco-title">한전 서류까지 저희가 챙깁니다</h2>
        <div>
          <p>증설, 승압, 임시전력, 모자분리. 신청 종류마다 다른 절차와 준비 서류를 정리해 두었습니다.</p>
          <a class="btn btn--primary" href="#kepco">한전 신청 안내</a>
        </div>
      </div>
    </section>

    <section class="section" id="company" aria-labelledby="company-title">
      <div class="container company">
        <div>
          <h2 id="company-title">현장 상담은 전화로</h2>
          <p class="lead">{company.hours}. 상황을 듣고 방문 일정을 바로 잡습니다.</p>
          <a class="btn btn--primary" href={telHref}>{company.phone}</a>
        </div>
        <table class="facts facts--company">
          <tbody>{info.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-row">
      <Logo variant="horizontal" class="footer-logo" />
      <p>{company.nameKo}. 대표 {company.ceo}. {company.address}. 전화 {company.phone}, 이메일 {company.email}.{company.bizNumber && ` 사업자등록번호 ${company.bizNumber}.`}{company.licenseNumber && ` 전기공사업 ${company.licenseNumber}.`} © 2026 {company.nameEn}</p>
    </div>
  </footer>
  <CallBar />
</body>
</html>
