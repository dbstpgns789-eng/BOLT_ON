---
// 시공사례 상세 시안: C1 brief (gesung) / C2 data (edison) / C3 story (haeun·sinrok).
import { getCollection } from 'astro:content';
import DraftLayout from '../../../../layouts/DraftLayout.astro';
import SiteHeader from '../../../../components/home/SiteHeader.astro';
import SiteFooter from '../../../../components/home/SiteFooter.astro';
import CaseDetail from '../../../../components/cases/CaseDetail.astro';
import ConsultForm from '../../../../components/service/ConsultForm.astro';

export async function getStaticPaths() {
  const list = (await getCollection('cases')).sort((a, b) => b.data.completed.localeCompare(a.data.completed));
  return ['c1', 'c2', 'c3'].flatMap((v) => list.map((entry, i) => ({ params: { v, id: entry.id }, props: { entry, prev: list[i - 1], next: list[i + 1] } })));
}
const { v } = Astro.params;
const { entry, prev, next } = Astro.props;
const variant = ({ c1: 'brief', c2: 'data', c3: 'story' } as const)[v as 'c1' | 'c2' | 'c3'];
const base = `/drafts/cases/${v}/`;
---
<DraftLayout variant="svc">
  <SiteHeader />
  <main id="top">
    <CaseDetail entry={entry} variant={variant} listHref={base} prev={prev} next={next} base={base} />
    <ConsultForm slug={entry.data.service} />
  </main>
  <SiteFooter variant="haeun" dark />
</DraftLayout>
