---
// Not found (Cloudflare Pages serves dist/404.html). Without it Pages falls back to the home page for unknown paths.
import DraftLayout from '../layouts/DraftLayout.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { menu } from '../data/menu';
---
<DraftLayout variant="svc">
  <SiteHeader />
  <main id="top">
    <section class="section notfound" aria-labelledby="nf-title">
      <div class="container">
        <h1 id="nf-title">페이지를 찾을 수 없습니다</h1>
        <p>주소가 바뀌었거나 없는 페이지입니다. 아래에서 찾으시는 곳으로 가실 수 있습니다.</p>
        <div class="notfound-actions">
          <a class="btn btn--primary" href="/">처음 화면으로</a>
          <a class="btn btn--line" href="/consult/">상담 예약</a>
        </div>
        <ul class="notfound-links">{menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
      </div>
    </section>
  </main>
  <SiteFooter variant="haeun" dark />
</DraftLayout>
