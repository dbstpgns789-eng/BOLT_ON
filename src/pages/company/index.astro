---
// 회사개요, decorated (2026-11-11), every element from real material:
// photo collage intro (wooilenc 인사말 collage: photo + navy and amber blocks)
// · how we work, with site photos (gesung three points + sinrok photo steps)
// · company facts table (wooilenc 회사개요) · license (edison, shown once issued) · areas. No CEO greeting: client declined (요청서 3-4).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import CompanyHead from '../../components/company/CompanyHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { company } from '../../config/company';
import { companyRows } from '../../lib/company-rows';
import { services } from '../../data/services';
import collageMain from '../../assets/cases/cheongju-substation/01-substation.jpg';
import collageSub from '../../assets/cases/seodaemun-prison/01-led-ceiling.jpg';
import wayPhoto1 from '../../assets/stock/site-review-tablet.jpg';
import wayPhoto2 from '../../assets/cases/cheongju-substation/05-wiring.jpg';
import wayPhoto3 from '../../assets/cases/dongdaemun-kindergarten/03-after.jpg';

// From the CEO's three sentences in 요청서 3-2 (split in three; the client checks the wording).
const ways = [
  { n: '01', title: '현장을 먼저 봅니다', line: '현장마다 전기 사용 환경이 다릅니다. 먼저 직접 확인하고, 필요한 용량과 공사 범위를 설명드린 뒤 시공합니다.', img: wayPhoto1, alt: '현장에서 도면을 함께 확인하는 모습' },
  { n: '02', title: '한전 서류까지 함께', line: '한전 신청 서류도 함께 준비해, 처음 상담부터 준공까지 한 번에 진행합니다.', img: wayPhoto2, alt: '수배전반 결선 작업' },
  { n: '03', title: '끝난 뒤까지 책임집니다', line: '정직한 견적과 안전한 시공, 공사 후 책임 있는 A/S로 끝까지 책임집니다.', img: wayPhoto3, alt: '공사를 마친 분전반' },
];
---
<BaseLayout title="회사개요">
  <SiteHeader />
  <main id="top">
    <CompanyHead current="overview" title="회사개요" />

    <section class="section about-hero" aria-labelledby="about-title">
      <div class="container about-hero-row">
        <div class="about-hero-text">
          <h2 id="about-title">전기 증설과 수변전설비를 전문으로 하는 전기공사 업체</h2>
          <p class="svc-lead">볼트온이엔씨는 전기 증설과 승압, 수변전설비, 리모델링, 신·증축 전기공사를 전문으로 합니다.</p>
        </div>
        <div class="collage" aria-hidden="false">
          <span class="collage-navy" aria-hidden="true"></span>
          <span class="collage-amber" aria-hidden="true"></span>
          <Image class="collage-main" src={collageMain} alt="청주 식품공장에 설치한 옥외 변전설비" widths={[480, 720]} sizes="(max-width: 60rem) 80vw, 420px" />
          <Image class="collage-sub" src={collageSub} alt="서대문형무소역사관 전시실 천장 미디어 조명" widths={[360, 540]} sizes="(max-width: 60rem) 50vw, 280px" />
        </div>
      </div>
    </section>


    <section class="section section--tint" aria-labelledby="ways-title">
      <div class="container">
        <div class="head"><h2 id="ways-title">일하는 방식</h2></div>
        <ol class="ways ways--photo">
          {ways.map((w) => (
            <li>
              <Image class="ways-img" src={w.img} alt={w.alt} widths={[400, 600]} sizes="(max-width: 60rem) 100vw, 380px" />
              <div class="ways-body"><span class="ways-n">{w.n}</span><h3>{w.title}</h3><p>{w.line}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>


    <section class="section section--tint" aria-labelledby="facts-title">
      <div class="container company">
        <div class="head">
          <h2 id="facts-title">회사 정보</h2>
          <p>전화로 상황을 말씀해 주시면 방문 일정을 잡아 드립니다.</p>
        </div>
        <table class="info"><tbody>{companyRows().map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
      </div>
    </section>

    {company.licenseNumber && (
      <section class="section" aria-labelledby="license-title">
        <div class="container">
          <div class="head"><h2 id="license-title">면허</h2></div>
          <p class="license">전기공사업 등록 {company.licenseNumber}</p>
        </div>
      </section>
    )}

    <section class="section svc-others" aria-labelledby="areas-title">
      <div class="container">
        <div class="head"><h2 id="areas-title">사업분야</h2></div>
        <ul class="others others--5">
          {services.map((s) => <li><a href={`/services/${s.slug}/`}><span class="others-name">{s.name}</span><span class="others-line">{s.tasks.slice(0, 2).join(', ')}</span></a></li>)}
        </ul>
      </div>
    </section>
    <CtaBand />
  </main>
  <SiteFooter />
</BaseLayout>
