---
// 오시는 길 (wooilenc location: map + address + route buttons; edison 오시는 길).
// Map: Google embed needs no key; Naver/Kakao buttons open the apps most visitors use.
// Address is the 지번 from 요청서; switch to the 도로명 address once the business registration arrives.
import DraftLayout from '../../layouts/DraftLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import CompanyHead from '../../components/company/CompanyHead.astro';
import { company, telHref } from '../../config/company';

const q = encodeURIComponent(company.address);
---
<DraftLayout variant="svc" title="오시는 길" description="경기도 남양주시 화도읍 녹촌리 380-1, 볼트온이엔씨 오시는 길입니다.">
  <SiteHeader />
  <main id="top">
    <CompanyHead current="location" title="오시는 길" />

    <section class="section location" aria-labelledby="loc-title">
      <div class="container location-row">
        <div class="map-frame">
          <iframe title={`${company.nameKo} 위치 지도`} src={`https://www.google.com/maps?q=${q}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="loc-info">
          <h2 id="loc-title">{company.nameKo}</h2>
          <dl class="loc-list">
            <div><dt>주소</dt><dd>{company.address}</dd></div>
            <div><dt>전화</dt><dd><a href={telHref}>{company.phone}</a></dd></div>
            <div><dt>이메일</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
            <div><dt>상담 시간</dt><dd>{company.hours}</dd></div>
          </dl>
          <div class="loc-routes">
            <a class="btn btn--naver" href={`https://map.naver.com/p/search/${q}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M16.273 12.845 7.376 0H0v24h7.726V11.156L16.624 24H24V0h-7.727z"/></svg> 네이버 지도</a>
            <a class="btn btn--kakao" href={`https://map.kakao.com/link/search/${q}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg> 카카오맵</a>
          </div>
          {/* CHECK with the client: field-based office, so a call before visiting */}
          <p class="loc-note">현장 작업이 많아 사무실을 비울 때가 있습니다. 방문하시기 전에 전화 주시면 시간을 맞춰 드립니다.</p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter variant="haeun" dark />
</DraftLayout>
