---
// Mobile-only bottom bar: the page's one action, always in reach (grilling Q8, uri 하단 상담 바 pattern).
import { company, telHref } from '../config/company';
---
<nav class="callbar" aria-label="빠른 상담">
  <a class="callbar-call" href={telHref}>전화 상담 {company.phone}</a>
  {company.kakaoChannelUrl && <a class="callbar-kakao" href={company.kakaoChannelUrl}>카카오톡</a>}
</nav>
<style>
  .callbar { display: none; }
  @media (max-width: 40rem) {
    .callbar { position: fixed; inset: auto 0 0 0; z-index: var(--z-sticky); display: flex; gap: var(--space-xs); padding: var(--space-xs) var(--gutter) calc(var(--space-xs) + env(safe-area-inset-bottom)); background: var(--color-paper); border-top: var(--rule-hair) solid var(--color-rule); }
    .callbar a { flex: 1; display: grid; place-items: center; min-height: 48px; font-weight: 600; text-decoration: none; }
    .callbar-call { background: var(--color-accent); color: var(--color-accent-ink); }
    .callbar .callbar-kakao { flex: 0 0 auto; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-ink); }
    .callbar a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -4px; }
    :global(body) { padding-bottom: 72px; }
  }
</style>
