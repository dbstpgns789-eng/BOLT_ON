---
// Case detail (fixed 2026-11-11): photo head, large cover, summary, 공사 전 상황 (when given), facts table,
// numbered key work, one set of site photos with a viewer, previous / list / next.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { services } from '../../data/services';
import { ym } from '../../lib/format';

interface Props { entry: CollectionEntry<'cases'>; prev?: CollectionEntry<'cases'>; next?: CollectionEntry<'cases'> }
const { entry, prev, next } = Astro.props;
const d = entry.data;
const service = services.find((s) => s.slug === d.service)!;
const cover = d.photos.find((p) => p.stage === 'after') ?? d.photos[0];
const facts: [string, string | undefined][] = [
  ['사업분야', service.name], ['현장', d.site], ['건물', d.building], ['지역', d.region],
  ['용량', d.capacity], ['완공', ym(d.completed)], ['공사 기간', d.duration],
];
---
<article class="cd cd--final">
  <header class="cd-head cd-head--photo">
    <Image class="cd-head-img" src={cover.src} alt="" widths={[800, 1440, 2000]} sizes="100vw" loading="eager" />
    <div class="container cd-head-text">
      <p class="cd-crumb"><a href="/">홈</a> <span aria-hidden="true">/</span> <a href="/cases/">시공사례</a></p>
      <p class="cd-area"><a href={`/services/${d.service}/`}>{service.name}</a></p>
      <h1>{d.title}</h1>
      <p class="cd-meta">{d.region}, {ym(d.completed)} 완공{d.duration && `, 공사 기간 ${d.duration}`}</p>
    </div>
  </header>

  <div class="container cd-body">
    <figure class="cd-cover"><a class="cd-zoom" href={cover.src.src} aria-label={`${cover.caption} 크게 보기`}><Image src={cover.src} alt={cover.caption} widths={[640, 960, 1280]} sizes="(max-width: 60rem) 100vw, 760px" loading="eager" /></a><figcaption>{cover.caption}</figcaption></figure>

    <div class="cd-side">
      {d.summary && <p class="cd-summary">{d.summary}</p>}
      {d.problem && <div class="cd-problem"><h2 class="cd-sub">공사 전 상황</h2><p>{d.problem}</p></div>}
      <table class="info cd-facts"><tbody>{facts.filter(([, v]) => v).map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
      <h2 class="cd-sub">주요 작업</h2>
      <ol class="cd-work cd-work--num">{d.tags.map((t) => <li>{t}</li>)}</ol>
    </div>
  </div>

  <section class="container cd-photos" aria-label="현장 사진">
    <div class="cd-stage">
      <h2 class="cd-sub">현장 사진</h2>
      <ul>{d.photos.map((p) => <li><figure><a class="cd-zoom" href={p.src.src} aria-label={`${p.caption} 크게 보기`}><Image src={p.src} alt={p.caption} widths={[360, 560]} sizes="(max-width: 60rem) 50vw, 300px" /></a><figcaption>{p.caption}</figcaption></figure></li>)}</ul>
    </div>
  </section>

  <nav class="container cd-nav" aria-label="다른 시공사례">
    {prev ? <a class="cd-prev" href={`/cases/${prev.id}/`}><span>이전 사례</span>{prev.data.title}</a> : <span></span>}
    <a class="cd-list" href="/cases/">목록으로</a>
    {next ? <a class="cd-next" href={`/cases/${next.id}/`}><span>다음 사례</span>{next.data.title}</a> : <span></span>}
  </nav>
  <dialog class="lightbox" aria-label="사진 크게 보기">
    <div class="lightbox-bar">
      <span class="lightbox-count" aria-live="polite"></span>
      <button type="button" class="lightbox-close">닫기</button>
    </div>
    <div class="lightbox-stage">
      <button type="button" class="lightbox-nav" data-step="-1" aria-label="이전 사진">이전</button>
      <button type="button" class="lightbox-nav" data-step="1" aria-label="다음 사진">다음</button>
    </div>
    <p class="lightbox-cap"></p>
  </dialog>
</article>
<script>
  // Tap a site photo to see it large. Previous/next buttons, arrow keys or a swipe move through the site photos;
  // Esc, the close button or a tap outside the photo closes it. Without script the photo link opens the file.
  const box = document.querySelector<HTMLDialogElement>('.lightbox');
  if (box && 'showModal' in box) {
    const list = [...document.querySelectorAll<HTMLAnchorElement>('.cd-photos .cd-zoom')];
    const stage = box.querySelector('.lightbox-stage')!;
    const cap = box.querySelector('.lightbox-cap')!;
    const count = box.querySelector('.lightbox-count')!;
    let img: HTMLImageElement | null = null; // made on first open, so the page has no empty <img>
    let at = 0;
    const show = (n: number) => {
      at = (n + list.length) % list.length;
      const a = list[at];
      const alt = a.querySelector('img')?.alt ?? '';
      if (!img) { img = new Image(); stage.prepend(img); }
      img.src = a.href; img.alt = alt; cap.textContent = alt;
      count.textContent = `${at + 1} / ${list.length}`;
    };
    document.querySelectorAll<HTMLAnchorElement>('.cd-zoom').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      const k = list.findIndex((x) => x.href === a.href);
      show(k < 0 ? 0 : k);
      box.showModal();
    }));
    box.querySelectorAll<HTMLButtonElement>('.lightbox-nav').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.step))));
    box.querySelector('.lightbox-close')!.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
    box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
    let x0 = 0;
    stage.addEventListener('touchstart', (e) => { x0 = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => { const dx = (e as TouchEvent).changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1)); });
  }
</script>
