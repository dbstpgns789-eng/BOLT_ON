---
// Process steps drawn as a diagram (2026-11-11 drafts). variant:
// boxes (numbered boxes with chevrons, wooilenc 8-step chart) | timeline (dots on one line, colour = who) | lanes (swimlane: a row per owner)
import { ownerLabel, type Owner } from '../data/service-pages';

interface Props { steps: { name: string; line: string; owner: Owner }[]; variant?: 'boxes' | 'timeline' | 'lanes' }
const { steps, variant = 'boxes' } = Astro.props;
const cols = steps.length > 6 ? 4 : 3;
const lanes: Owner[] = ['volton', 'customer', 'kepco'];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
{variant === 'boxes' && (
  <ol class={`flow flow--${cols}`}>
    {steps.map((s, i) => (
      <li class={`flow-step flow-step--${s.owner}`}>
        <span class="flow-num">{num(i)}</span>
        <h3>{s.name}</h3>
        <p>{s.line}</p>
        <span class="os-owner">{ownerLabel[s.owner]}</span>
      </li>
    ))}
  </ol>
)}
{variant === 'timeline' && (
  <>
    <ul class="pf-legend" aria-label="담당 표시">{lanes.map((o) => <li><span class={`tl-dot tl-dot--${o} tl-dot--key`} aria-hidden="true"></span>{ownerLabel[o]}</li>)}</ul>
    <ol class="tl" style={`--tl-n: ${steps.length}`}>
      {steps.map((s, i) => (
        <li class="tl-step">
          <span class={`tl-dot tl-dot--${s.owner}`} aria-hidden="true">{i + 1}</span>
          <h3>{s.name}</h3>
          <p>{s.line}</p>
          <span class="tl-owner">{ownerLabel[s.owner]}</span>
        </li>
      ))}
    </ol>
  </>
)}
{variant === 'lanes' && (
  <ol class="lanes" style={`--ln-n: ${steps.length}`}>
    {lanes.map((o, r) => <li class={`ln-band ln-band--${o}`} style={`grid-row: ${r + 1}`} aria-hidden="true"><span class="ln-label">{ownerLabel[o]}</span></li>)}
    {steps.map((s, i) => (
      <li class={`ln-step ln-step--${s.owner}`} style={`grid-column: ${i + 2}; grid-row: ${lanes.indexOf(s.owner) + 1}`}>
        <span class="flow-num">{num(i)}</span>
        <h3>{s.name}</h3>
        <p>{s.line}</p>
        <span class="ln-owner">{ownerLabel[s.owner]}</span>
      </li>
    ))}
  </ol>
)}
