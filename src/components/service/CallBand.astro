---
// One quiet call band (gesung "시공 범위가 궁금하신가요?"), not an ad banner.
import { company, telHref } from '../../config/company';
interface Props { title?: string }
const { title = '우리 건물에 맞는지 궁금하시면' } = Astro.props;
---
<section class="call-band" aria-label="상담 안내">
  <div class="container call-band-row">
    <div>
      <p class="call-band-title">{title}</p>
      <p>현장을 보고 필요한 공사인지부터 말씀드립니다. {company.hours}</p>
    </div>
    <a class="btn btn--primary" href={telHref}>전화 상담 {company.phone}</a>
  </div>
</section>
