---
// Cases in this area only; hidden when there are none (변압기 교체, 신·증축 have none yet).
// variant: grid (every photo of these cases, wooilenc photo grid) | cards (one card per case, sinrok)
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ServiceSlug } from '../../data/services';
import { ym, stageKo } from '../../lib/format';

interface Props { slug: ServiceSlug; variant?: 'grid' | 'cards' }
const { slug, variant = 'cards' } = Astro.props;
const list = (await getCollection('cases')).filter((c) => c.data.service === slug);
---
{list.length > 0 && (
  <section class="section svc-cases" aria-labelledby="svc-cases-title">
    <div class="container">
      <div class="head head--row"><h2 id="svc-cases-title">이 분야 시공사례</h2><a class="more" href={`/cases/?area=${slug}`}>전체 시공사례</a></div>
      {variant === 'grid' ? (
        <ul class="svc-photo-grid">
          {list.flatMap((c) => c.data.photos.map((p) => (
            <li><figure><Image src={p.src} alt={p.caption} widths={[320, 480]} sizes="(max-width: 60rem) 50vw, 300px" /><figcaption>{stageKo[p.stage]}, {p.caption}</figcaption></figure></li>
          )))}
        </ul>
      ) : (
        <ul class="case-row">
          {list.map((c) => {
            const cover = c.data.photos.find((p) => p.stage === 'after') ?? c.data.photos[0];
            return (
              <li><a class="case-card" href={`/cases/${c.id}/`}>
                <Image src={cover.src} alt={cover.caption} widths={[400, 640]} sizes="(max-width: 60rem) 50vw, 360px" />
                <span class="case-card-title">{c.data.title}</span>
                <span class="case-card-meta">{c.data.region}, {ym(c.data.completed)} 완공{c.data.duration && `, ${c.data.duration}`}</span>
              </a></li>
            );
          })}
        </ul>
      )}
    </div>
  </section>
)}
