---
// Callback request (option A, 2026-11-11): the visitor leaves a number and a time, Volt On calls back.
// Posts to Web3Forms when company.formAccessKey is set; until then the script shows a "not connected" notice.
// Collecting a name and phone number needs consent and a privacy policy page (요청서 5-4).
import { company } from '../../config/company';
import { services, type ServiceSlug } from '../../data/services';

interface Props { slug?: ServiceSlug }
const { slug } = Astro.props;
const area = slug ? services.find((s) => s.slug === slug)!.name : '';
---
<section class="section section--tint consult" id="consult" aria-labelledby="consult-title">
  <div class="container consult-row">
    <div class="consult-head">
      <h2 id="consult-title">상담 전화 예약</h2>
      <p>번호와 편한 시간을 남겨 주시면, 그 시간에 맞춰 저희가 먼저 전화드립니다.</p>
      <p class="consult-hours">{company.hours}</p>
    </div>
    <form class="consult-form" method="post" action="https://api.web3forms.com/submit" data-key={company.formAccessKey}>
      <input type="hidden" name="access_key" value={company.formAccessKey} />
      <input type="hidden" name="subject" value={`[홈페이지] ${area || '전기공사'} 상담 예약`} />
      {area ? <input type="hidden" name="분야" value={area} /> : (
        <div class="field field--wide">
          <label for="cf-area">관심 분야 <span class="optional">(선택)</span></label>
          <select id="cf-area" name="분야">
            <option value="">잘 모르겠음</option>
            {services.map((s) => <option value={s.name}>{s.name}</option>)}
            <option value="한전 신청 대행">한전 신청 대행</option>
            <option value="A/S 요청">A/S 요청 (시공한 곳의 문제)</option>
          </select>
        </div>
      )}
      <div class="field">
        <label for="cf-name">이름</label>
        <input id="cf-name" name="이름" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-phone">연락처</label>
        <input id="cf-phone" name="연락처" type="tel" inputmode="tel" autocomplete="tel" placeholder="010-0000-0000" required />
      </div>
      <fieldset class="field field--time">
        <legend>통화 원하는 시간</legend>
        <label><input type="radio" name="통화 시간" value="오전" /> 오전</label>
        <label><input type="radio" name="통화 시간" value="오후" /> 오후</label>
        <label><input type="radio" name="통화 시간" value="아무 때나" checked /> 아무 때나</label>
      </fieldset>
      <div class="field field--wide">
        <label for="cf-note">지역과 상황 <span class="optional">(선택)</span></label>
        <textarea id="cf-note" name="상황" rows="3" placeholder="예: 남양주 상가, 에어컨 늘리면서 차단기가 자주 떨어짐"></textarea>
      </div>
      <div class="field field--wide consent">
        <label><input type="checkbox" name="개인정보 동의" value="동의" required /> 개인정보 수집·이용에 동의합니다 (필수)</label>
        <p>수집 항목: 이름, 연락처, 상담 내용. 목적: 상담 연락. 보관 기간: {company.formRetention}. <a href="/privacy/">개인정보처리방침</a></p>
      </div>
      <div class="field field--wide consult-submit">
        <button class="btn btn--primary" type="submit">예약 요청 보내기</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('.consult-form');
  const status = form?.querySelector<HTMLElement>('.form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !status) return;
    if (!form.dataset.key) {
      status.textContent = '시안입니다. 전송 서비스가 아직 연결되지 않아 요청이 보내지지 않았습니다.';
      return;
    }
    status.textContent = '보내는 중입니다.';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = '예약 요청을 받았습니다. 말씀하신 시간에 전화드리겠습니다.';
    } catch {
      status.textContent = '보내지 못했습니다. 잠시 뒤 다시 시도하시거나 전화로 연락 주세요.';
    }
  });
</script>
