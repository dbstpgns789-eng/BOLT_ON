---
// Sub-tasks with line icons in navy circles (wooilenc 한전계약전력 page: 증설·승압·신설·모자분리·구좌분할·임시전력).
import type { ServicePage } from '../../data/service-pages';
interface Props { page: ServicePage }
const { page } = Astro.props;
const paths: Record<string, string> = {
  up: 'M12 19V5m0 0-6 6m6-6 6 6',
  phase: 'M4 7h16M4 12h16M4 17h16',
  plus: 'M12 5v14M5 12h14',
  split: 'M12 4v6m0 0-6 6v4m6-10 6 6v4',
  divide: 'M5 5h14v14H5zM12 5v14M5 12h14',
  clock: 'M12 7v5l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  box: 'M4 8l8-4 8 4v8l-8 4-8-4zM4 8l8 4 8-4M12 12v8',
  panel: 'M5 3h14v18H5zM9 7v4m3-4v4m3-4v4M8 15h8',
  cable: 'M4 6h6a4 4 0 0 1 0 8H8a4 4 0 0 0 0 8h12',
  swap: 'M7 7h12l-4-4m4 14H5l4 4',
  check: 'M5 12l4 4 10-10',
  light: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3 11v2h6v-2a6 6 0 0 0-3-11Z',
  plug: 'M9 3v5m6-5v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4',
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7z',
  doc: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h7M9 16h7',
};
---
{page.tasks && (
  <section class="section svc-tasks" aria-labelledby="tasks-title">
    <div class="container">
      <div class="head"><h2 id="tasks-title">세부 업무</h2></div>
      <ul class={`tasks-grid${page.tasks.length === 3 ? " tasks-grid--3" : ""}`}>
        {page.tasks.map((t) => (
          <li>
            <span class="task-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d={paths[t.icon]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <div><h3>{t.name}</h3><p>{t.line}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
