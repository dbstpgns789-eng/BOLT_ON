---
// Three questions, open/close without script (<details>), after edison's service FAQ.
import type { ServicePage } from '../../data/service-pages';
interface Props { page: ServicePage }
const { page } = Astro.props;
---
<section class="section section--tint svc-faq" aria-labelledby="faq-title">
  <div class="container svc-faq-row">
    <h2 id="faq-title">자주 묻는 질문</h2>
    <div class="faq-list">
      {page.faq.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
