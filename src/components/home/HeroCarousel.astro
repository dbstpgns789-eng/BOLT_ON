---
// Photo carousel under the nav (client pick from sinrok.co.kr), 60vh so the case strip shows below it.
// Slides change every 5 s, pausing while hovered or focused; only < > buttons, no counter (client, 2026-11-11).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide { img: ImageMetadata; alt: string; head: string; line: string; pos?: string }
interface Props { slides: Slide[] }
const { slides } = Astro.props;
---
<section class="hero hero--short" aria-roledescription="carousel" aria-label="볼트온이엔씨 소개">
  <div class="slides">
    {slides.map((s, i) => (
      <div class={`slide${i === 0 ? ' is-active' : ''}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} aria-hidden={i === 0 ? 'false' : 'true'} inert={i !== 0}>
        <Image src={s.img} alt={s.alt} widths={[800, 1280, 1920, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position: ${s.pos ?? '50% 50%'}`} />
        <div class="container slide-text">
          {i === 0 ? <h1 class="slide-head">{s.head}</h1> : <p class="slide-head">{s.head}</p>}
          <p class="lead">{s.line}</p>
          <div class="actions">
            <a class="btn btn--primary" href="/consult/">상담 예약</a>
            <a class="btn btn--ghost" href="/cases/">시공사례 보기</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="container slide-controls">
    <button class="slide-btn slide-btn--icon" type="button" data-dir="-1" aria-label="이전 사진"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button class="slide-btn slide-btn--icon" type="button" data-dir="1" aria-label="다음 사진"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
</section>
<script>
  const root = document.querySelector('.hero');
  const slides = [...document.querySelectorAll('.slide')];
  let i = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => { s.classList.toggle('is-active', k === i); s.setAttribute('aria-hidden', String(k !== i)); s.toggleAttribute('inert', k !== i); });
  };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stop = () => { if (timer) window.clearInterval(timer); };
  const start = () => { if (!reduce) { stop(); timer = window.setInterval(() => show(i + 1), 5000); } };
  document.querySelectorAll<HTMLButtonElement>('.slide-btn').forEach((b) => b.addEventListener('click', () => { show(i + Number(b.dataset.dir)); start(); }));
  root?.addEventListener('mouseenter', stop);
  root?.addEventListener('mouseleave', start);
  root?.addEventListener('focusin', stop);
  root?.addEventListener('focusout', start);
  start();
</script>
