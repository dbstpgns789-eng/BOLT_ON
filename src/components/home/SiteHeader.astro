---
import Logo from '../Logo.astro';
import { company } from '../../config/company';
import { menu } from '../../data/menu';
---
<header class="nav">
  <div class="container nav-row">
    <a class="brand" href="/" aria-label={`${company.nameKo} 처음으로`}><Logo class="brand-logo" /></a>
    <nav class="gnb" aria-label="주요 메뉴">
      <ul class="gnb-list">
        {menu.map((m) => (
          <li class="gnb-item">
            <a class="gnb-link" href={m.href}>{m.label}</a>
            <ul class="gnb-sub">{m.sub.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
          </li>
        ))}
      </ul>
      <div class="gnb-panel" aria-hidden="true"></div>
    </nav>
    <details class="mnav">
      <summary><span class="mnav-when-closed">메뉴</span><span class="mnav-when-open">닫기</span></summary>
      <div class="mnav-body">
        {menu.map((m) => (
          <div class="mnav-group">
            <a class="mnav-head" href={m.href}>{m.label}</a>
            {m.sub.map(([t, h]) => <a href={h}>{t}</a>)}
          </div>
        ))}
      </div>
    </details>
  </div>
</header>
