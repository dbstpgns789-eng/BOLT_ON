---
// Home process summary: five navy chevrons (after the wooilenc KEPCO diagram). Area pages and /kepco/ use ProcessFlow instead.
import { steps } from '../../data/services';
---
<section class="section section--tint steps steps--chevrons" aria-labelledby="steps-title" data-reveal>
  <div class="container">
    <div class="head">
      <h2 id="steps-title">진행 순서</h2>
      <p>한전 신청 서류는 공사와 함께 준비합니다.</p>
    </div>
    <ol class="chevrons">
      {steps.map((s, i) => (
        <li><span class="c-num">{i + 1}</span><h3>{s.name}</h3><p>{s.line}</p></li>
      ))}
    </ol>
  </div>
</section>
