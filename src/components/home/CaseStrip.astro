---
// Cases as image cards in a row. variant: cards (3 large, after sinrok) | strip (all, compact, right under the hero, after gesung)
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { services } from '../../data/services';
import { ym } from '../../lib/format';

interface Props { variant?: 'cards' | 'strip' }
const { variant = 'cards' } = Astro.props;
const all = (await getCollection('cases')).sort((a, b) => (a.data.featured ?? 99) - (b.data.featured ?? 99));
const list = variant === 'cards' ? all.slice(0, 3) : all;
const serviceName = Object.fromEntries(services.map((s) => [s.slug, s.name]));
---
<section class={`section case-${variant}`} id="cases" aria-labelledby="cases-title" data-reveal>
  <div class="container">
    <div class="head head--row">
      <div><h2 id="cases-title">{variant === 'strip' ? '최근 시공 현장' : '시공사례'}</h2></div>
      <a class="more" href="/cases/">전체 보기</a>
    </div>
    <ul class="case-row">
      {list.map((c) => {
        const cover = c.data.photos.find((p) => p.stage === 'after') ?? c.data.photos[0];
        return (
          <li>
            <a class="case-card" href={`/cases/${c.id}/`}>
              <Image src={cover.src} alt={cover.caption} widths={[400, 640]} sizes="(max-width: 60rem) 50vw, 360px" />
              <span class="case-card-area">{serviceName[c.data.service]}</span>
              <span class="case-card-title">{c.data.title}</span>
              <span class="case-card-meta">{ym(c.data.completed)} 완공</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
