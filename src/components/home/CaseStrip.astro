---
// Every case as a compact image card, newest first, right under the hero (after gesung).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { services } from '../../data/services';
import { ym } from '../../lib/format';

const list = (await getCollection('cases')).sort((a, b) => b.data.completed.localeCompare(a.data.completed));
const serviceName = Object.fromEntries(services.map((s) => [s.slug, s.name]));
---
<section class="section case-strip" id="cases" aria-labelledby="cases-title" data-reveal>
  <div class="container">
    <div class="head head--row">
      <div><h2 id="cases-title">최근 시공 현장</h2></div>
      <a class="more" href="/cases/">시공사례 전체 보기</a>
    </div>
    <ul class="case-row">
      {list.map((c) => {
        const cover = c.data.photos.find((p) => p.stage === 'after') ?? c.data.photos[0];
        return (
          <li>
            <a class="case-card" href={`/cases/${c.id}/`}>
              <Image src={cover.src} alt={cover.caption} widths={[400, 640]} sizes="(max-width: 60rem) 50vw, 360px" />
              <span class="case-card-area">{serviceName[c.data.service]}</span>
              <span class="case-card-title">{c.data.title}</span>
              <span class="case-card-meta">{ym(c.data.completed)} 완공</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
